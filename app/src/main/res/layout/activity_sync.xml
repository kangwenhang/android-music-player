<?xml version="1.0" encoding="utf-8"?>
<!-- 音乐同步界面:从 Navidrome 下载全部音乐到本地 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/title_bar_padding"
        android:background="@color/bg_title_bar">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="音乐同步"
            android:textColor="@color/text_title"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn"
            android:text="返回"
            android:textColor="@color/btn_text"
            android:textSize="@dimen/sub_text_size"
            android:minWidth="72dp" />
    </LinearLayout>

    <!-- 内容区 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 同步目录显示 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="同步目录"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/sub_text_size"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tv_sync_path"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_search"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/search_text_size"
                android:paddingLeft="@dimen/search_padding"
                android:paddingRight="@dimen/search_padding"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:minHeight="@dimen/search_height"
                android:gravity="center_vertical" />

            <!-- 已同步统计 -->
            <TextView
                android:id="@+id/tv_synced_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/source_network"
                android:textSize="@dimen/sub_text_size"
                android:text="已同步: 0 首" />

            <!-- 进度区 -->
            <LinearLayout
                android:id="@+id/ll_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="24dp"
                android:visibility="gone">

                <!-- 进度文字 -->
                <TextView
                    android:id="@+id/tv_progress_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/sub_text_size"
                    android:text="准备中..." />

                <!-- 进度条 -->
                <ProgressBar
                    android:id="@+id/pb_sync"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="0" />

                <!-- 进度数字 -->
                <TextView
                    android:id="@+id/tv_progress_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/time_text_size"
                    android:gravity="right" />
            </LinearLayout>

            <!-- 结果区(同步完成后显示) -->
            <TextView
                android:id="@+id/tv_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/sub_text_size"
                android:lineSpacingExtra="4dp"
                android:visibility="gone" />

            <!-- 按钮区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp"
                android:gravity="center">

                <Button
                    android:id="@+id/btn_sync"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/btn_size"
                    android:layout_marginRight="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_btn_play"
                    android:text="开始同步"
                    android:textColor="@color/btn_play_text"
                    android:textSize="@dimen/btn_text_size" />

                <Button
                    android:id="@+id/btn_cancel"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="@dimen/btn_size"
                    android:background="@drawable/bg_btn"
                    android:text="取消"
                    android:textColor="@color/btn_text"
                    android:textSize="@dimen/btn_text_size"
                    android:enabled="false" />
            </LinearLayout>

            <!-- 说明 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="说明:\n1. 同步会下载服务器所有音乐到本地\n2. 下载完成后网络模式从本地播放,不卡顿\n3. 已下载的文件会跳过(增量同步)\n4. 同步过程中请保持网络连接\n5. 可在设置中修改同步目录"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
