<?xml version="1.0" encoding="utf-8"?>
<!-- 播放列表弹窗(当前播放队列,全屏:渐变头部 + 圆角卡片行)
     【2026-11-22 v6.6】与设置/EQ 快捷弹窗同款结构:头部渐变 + 卡片行 + 当前播放行高亮。
     【2026-11-22 v6.6.2】ListView → RecyclerView + ItemTouchHelper:
     长按行拖动调整播放顺序;点击任意一行 = 从该首起重设队列并开始播放。
     RecyclerView 没有 listSelector,顺带根治了"选中高亮方角从卡片圆角处溢出"的问题。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- 头部(与设置/EQ 快捷弹窗同款渐变) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        android:background="@drawable/bg_settings_header">

        <!-- 图标用控制栏同款 PNG(日/夜两套资源,随主题自动换色) -->
        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_playlist"
            android:contentDescription="@string/playlist_title" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginLeft="12dp"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_playlist_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/playlist_title"
                android:textColor="@color/text_title"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- 副标题:共 N 首 · 正在播放第 M 首 -->
            <TextView
                android:id="@+id/tv_playlist_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_playlist_close"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:background="@drawable/bg_dialog_close"
            android:text="✕"
            android:textColor="@color/text_title"
            android:textSize="22sp" />
    </LinearLayout>

    <!-- 队列列表(卡片行,Java 填充;行间距 6dp 由 ItemDecoration 补) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_playlist"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
