<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面:横屏,左侧列表 + 右侧歌词(封面做底色),顶部按钮栏,底部控制栏,适配 1024x600 车机 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/title_bar_padding"
        android:background="@drawable/bg_title_bar">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_music_note"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="@string/app_name"
            android:textColor="@color/text_title"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/sub_text_size" />

        <!-- 同步进度(网络模式自动同步时显示) -->
        <TextView
            android:id="@+id/tv_sync_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:textColor="@color/source_network"
            android:textSize="@dimen/time_text_size"
            android:visibility="gone" />

        <!-- 搜索栏(实时搜索,系统输入法) -->
        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="@dimen/search_height"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_search"
            android:hint="搜索本地歌曲、歌手、专辑..."
            android:textColorHint="@color/search_hint"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/search_text_size"
            android:paddingLeft="@dimen/search_padding"
            android:paddingRight="@dimen/search_padding"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <!-- 收藏夹按钮 -->
        <Button
            android:id="@+id/btn_favorites"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_btn_height"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:minWidth="@dimen/top_btn_min_width"
            android:background="@drawable/bg_btn"
            android:text="\u2665 收藏"
            android:textColor="@color/btn_text"
            android:textSize="@dimen/sub_text_size" />

        <!-- 设置(均衡器+服务器统一入口,电阻屏加大) -->
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/top_btn_height"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:minWidth="@dimen/top_btn_min_width"
            android:background="@drawable/bg_btn"
            android:text="设置"
            android:textColor="@color/btn_text"
            android:textSize="@dimen/sub_text_size" />

        <!-- 服务器状态指示 -->
        <TextView
            android:id="@+id/tv_server_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:text="●未连接"
            android:textColor="@color/server_status_disconnected"
            android:textSize="@dimen/sub_text_size"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 中部:左侧歌曲列表 + 右侧歌词区(封面做底色) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧歌曲列表 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:overScrollMode="ifContentScrolls" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/sub_text_size"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 右侧:歌词区(封面放大模糊作为底色,歌词叠加在上) -->
        <com.captiva.musicplayer.LrcView
            android:id="@+id/lrc_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 底部播放控制栏(车机电阻屏优化:大按钮+大间距) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/control_bar_padding"
        android:paddingRight="@dimen/control_bar_padding"
        android:paddingTop="4dp"
        android:paddingBottom="@dimen/control_bar_padding"
        android:background="@drawable/bg_control_bar">

        <!-- 进度条 + 时间(同一行) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/time_text_size"
                android:layout_marginRight="8dp" />

            <SeekBar
                android:id="@+id/sb_progress"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:minHeight="32dp"
                android:maxHeight="32dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/time_text_size"
                android:layout_marginLeft="8dp" />
        </LinearLayout>

        <!-- 控制按钮(左) + 歌曲信息(右) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp">

            <!-- 左侧:控制按钮组(大圆形,适合车机电阻屏) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingLeft="4dp"
                android:paddingRight="4dp">

                <!-- 播放模式(小圆) -->
                <Button
                    android:id="@+id/btn_mode"
                    android:layout_width="@dimen/btn_circle_size"
                    android:layout_height="@dimen/btn_circle_size"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_circle"
                    android:text="顺"
                    android:textColor="@color/btn_text"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <!-- 上一首(小圆) -->
                <Button
                    android:id="@+id/btn_prev"
                    android:layout_width="@dimen/btn_circle_size"
                    android:layout_height="@dimen/btn_circle_size"
                    android:layout_marginLeft="@dimen/btn_circle_spacing"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_circle"
                    android:text="◀"
                    android:textColor="@color/btn_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- 播放/暂停(大圆,突出显示) -->
                <Button
                    android:id="@+id/btn_play"
                    android:layout_width="@dimen/btn_circle_big_size"
                    android:layout_height="@dimen/btn_circle_big_size"
                    android:layout_marginLeft="@dimen/btn_circle_spacing"
                    android:layout_marginRight="@dimen/btn_circle_spacing"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_circle_big_paused"
                    android:text="▶"
                    android:textColor="@color/btn_paused_text"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <!-- 下一首(小圆) -->
                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="@dimen/btn_circle_size"
                    android:layout_height="@dimen/btn_circle_size"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_circle"
                    android:text="▶"
                    android:textColor="@color/btn_text"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 右侧:歌曲标题 + 艺术家 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="right|center_vertical"
                android:layout_marginLeft="16dp"
                android:paddingRight="8dp">

                <TextView
                    android:id="@+id/tv_now_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="未在播放"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/now_title_text_size"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_now_artist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/sub_text_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
