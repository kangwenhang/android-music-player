<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面:横屏,左侧列表 + 右侧歌词(封面做底色),顶部按钮栏,底部控制栏,适配 1024x600 车机 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main">

    <!-- 顶部标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/title_bar_padding"
        android:background="@color/bg_title_bar">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_music_note"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="@string/app_name"
            android:textColor="@color/text_title"
            android:textSize="@dimen/title_text_size"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/sub_text_size" />

        <!-- 搜索栏(实时搜索,系统输入法) -->
        <EditText
            android:id="@+id/et_search"
            android:layout_width="0dp"
            android:layout_height="@dimen/search_height"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:background="@drawable/bg_search"
            android:hint="搜索本地歌曲、歌手、专辑..."
            android:textColorHint="@color/search_hint"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/search_text_size"
            android:paddingLeft="@dimen/search_padding"
            android:paddingRight="@dimen/search_padding"
            android:singleLine="true"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <!-- 来源切换:本地/网络(颜色区分当前模式) -->
        <Button
            android:id="@+id/btn_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:minWidth="72dp"
            android:minHeight="0dp"
            android:background="@drawable/bg_btn_source_local"
            android:text="本地"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="@dimen/sub_text_size" />

        <!-- 设置(均衡器+服务器统一入口) -->
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:minWidth="60dp"
            android:minHeight="0dp"
            android:background="@drawable/bg_btn"
            android:text="设置"
            android:textColor="@color/btn_text"
            android:textSize="@dimen/sub_text_size" />

        <!-- 服务器状态指示 -->
        <TextView
            android:id="@+id/tv_server_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginLeft="6dp"
            android:text="●未连接"
            android:textColor="@color/server_status_disconnected"
            android:textSize="@dimen/sub_text_size"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 中部:左侧歌曲列表 + 右侧歌词区(封面做底色) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左侧歌曲列表 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="vertical"
                android:overScrollMode="ifContentScrolls" />

            <TextView
                android:id="@+id/tv_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/sub_text_size"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 右侧:歌词区(封面放大模糊作为底色,歌词叠加在上) -->
        <com.captiva.musicplayer.LrcView
            android:id="@+id/lrc_view"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="2" />
    </LinearLayout>

    <!-- 底部播放控制栏(紧凑美观布局) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/control_bar_padding"
        android:paddingRight="@dimen/control_bar_padding"
        android:paddingTop="2dp"
        android:paddingBottom="@dimen/control_bar_padding"
        android:background="@drawable/bg_control_bar">

        <!-- 进度条 + 时间(同一行,紧凑) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginLeft="4dp"
            android:layout_marginRight="4dp">

            <TextView
                android:id="@+id/tv_current_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/time_text_size"
                android:layout_marginRight="6dp" />

            <SeekBar
                android:id="@+id/sb_progress"
                android:layout_width="0dp"
                android:layout_height="@dimen/seekbar_height"
                android:layout_weight="1"
                android:minHeight="@dimen/seekbar_height"
                android:maxHeight="@dimen/seekbar_height"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/tv_total_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/time_text_size"
                android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- 歌曲信息 + 控制按钮(同一行) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <!-- 左侧:歌曲标题 + 艺术家 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_now_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="未在播放"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/now_title_text_size"
                    android:textStyle="bold"
                    android:layout_marginRight="8dp" />

                <TextView
                    android:id="@+id/tv_now_artist"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/sub_text_size" />
            </LinearLayout>

            <!-- 右侧:控制按钮组 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_mode"
                    android:layout_width="@dimen/btn_size"
                    android:layout_height="@dimen/btn_size"
                    android:background="@drawable/bg_btn"
                    android:text="顺序"
                    android:textColor="@color/btn_text"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_prev"
                    android:layout_width="@dimen/btn_size"
                    android:layout_height="@dimen/btn_size"
                    android:layout_marginLeft="6dp"
                    android:background="@drawable/bg_btn"
                    android:text="上一首"
                    android:textColor="@color/btn_text"
                    android:textSize="@dimen/btn_text_size" />

                <Button
                    android:id="@+id/btn_play"
                    android:layout_width="@dimen/btn_size_play"
                    android:layout_height="@dimen/btn_size_play"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp"
                    android:background="@drawable/bg_btn_paused"
                    android:text="播放"
                    android:textColor="@color/btn_paused_text"
                    android:textSize="@dimen/btn_play_text_size"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_next"
                    android:layout_width="@dimen/btn_size"
                    android:layout_height="@dimen/btn_size"
                    android:background="@drawable/bg_btn"
                    android:text="下一首"
                    android:textColor="@color/btn_text"
                    android:textSize="@dimen/btn_text_size" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
