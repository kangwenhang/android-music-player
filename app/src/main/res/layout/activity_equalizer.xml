<?xml version="1.0" encoding="utf-8"?>
<!-- 均衡器界面(美化版) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/bg_eq_card"
            android:layout_marginBottom="16dp">

            <Button
                android:id="@+id/btn_eq_back"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:minWidth="80dp"
                android:background="@drawable/bg_eq_btn_back"
                android:text="返回"
                android:textColor="@color/btn_text"
                android:textSize="20sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="均衡器"
                android:textColor="@color/text_title"
                android:textSize="@dimen/title_text_size"
                android:textStyle="bold" />

            <View
                android:layout_width="80dp"
                android:layout_height="52dp" />
        </LinearLayout>

        <!-- 开关卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:background="@drawable/bg_eq_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="启用均衡器"
                android:textColor="@color/text_primary"
                android:textSize="22sp" />

            <Switch
                android:id="@+id/sw_eq_enable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:track="@drawable/bg_eq_switch_track"
                android:switchMinWidth="56dp" />
        </LinearLayout>

        <!-- 预设卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_eq_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="预设音效"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:layout_marginBottom="12dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_presets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- 频段调节卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_eq_card"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="频段调节"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:layout_marginBottom="12dp" />

            <!-- 频段调节区域(动态添加 VerticalSeekBar) -->
            <LinearLayout
                android:id="@+id/ll_bands"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_eq_band_panel"
                android:padding="16dp"
                android:minHeight="300dp" />

            <!-- 频段范围标签 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="start"
                    android:text="−"
                    android:textColor="@color/eq_freq_label"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="0 dB"
                    android:textColor="@color/eq_freq_label"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="+"
                    android:textColor="@color/eq_freq_label"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 提示文字 -->
        <TextView
            android:id="@+id/tv_eq_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="设置会自动保存,播放音乐时生效"
            android:textColor="@color/eq_hint_text"
            android:textSize="@dimen/sub_text_size" />

        <!-- 自定义预设与单曲绑定操作卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_eq_card"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="自定义与歌曲绑定"
                android:textColor="@color/text_secondary"
                android:textSize="20sp"
                android:layout_marginBottom="12dp" />

            <!-- 保存为自定义预设 -->
            <Button
                android:id="@+id/btn_save_custom"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_eq_btn_back"
                android:text="保存当前设置为自定义预设"
                android:textColor="@color/btn_text"
                android:textSize="20sp"
                android:layout_marginBottom="8dp" />

            <!-- 绑定当前EQ到正在播放的歌曲 -->
            <Button
                android:id="@+id/btn_bind_song"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_eq_btn_back"
                android:text="绑定当前EQ到此歌曲"
                android:textColor="@color/btn_text"
                android:textSize="20sp" />

            <!-- 当前歌曲EQ绑定状态 -->
            <TextView
                android:id="@+id/tv_song_binding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/eq_hint_text"
                android:textSize="@dimen/sub_text_size" />

            <!-- 提示:长按自定义预设可删除 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="提示:长按自定义预设可删除"
                android:textColor="@color/eq_hint_text"
                android:textSize="16sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
