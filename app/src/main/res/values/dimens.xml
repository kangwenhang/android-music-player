<?xml version="1.0" encoding="utf-8"?>
<!-- 车机专用尺寸:大字体、大按钮,便于驾驶盲操 -->
<resources>
    <!-- 标题栏(车机电阻屏优化) -->
    <dimen name="title_bar_padding">12dp</dimen>
    <dimen name="title_text_size">24sp</dimen>

    <!-- 通用文本 -->
    <dimen name="sub_text_size">18sp</dimen>
    <dimen name="time_text_size">18sp</dimen>

    <!-- 当前播放 -->
    <dimen name="now_title_text_size">20sp</dimen>

    <!-- 列表(紧凑,增加可见行数) -->
    <dimen name="list_item_padding">10dp</dimen>
    <dimen name="list_title_text_size">18sp</dimen>

    <!-- 控制栏 -->
    <dimen name="control_bar_padding">8dp</dimen>
    <dimen name="control_row_margin">2dp</dimen>
    <dimen name="seekbar_height">28dp</dimen>

    <!-- 按钮(减小,保持可触控) -->
    <dimen name="btn_size">50dp</dimen>
    <dimen name="btn_size_play">58dp</dimen>
    <dimen name="btn_text_size">18sp</dimen>
    <dimen name="btn_play_text_size">20sp</dimen>

    <!-- 圆形按钮(车机电阻屏优化:加大触摸区) -->
    <dimen name="btn_circle_size">64dp</dimen>
    <dimen name="btn_circle_big_size">80dp</dimen>
    <dimen name="btn_circle_spacing">16dp</dimen>

    <!-- 封面 -->
    <dimen name="cover_size_list">48dp</dimen>
    <dimen name="cover_size_now">96dp</dimen>
    <dimen name="cover_radius">8dp</dimen>

    <!-- 搜索栏(车机电阻屏优化) -->
    <dimen name="search_height">52dp</dimen>
    <dimen name="search_text_size">18sp</dimen>
    <dimen name="search_padding">12dp</dimen>

    <!-- 顶栏按钮(电阻屏优化) -->
    <dimen name="top_btn_height">52dp</dimen>
    <dimen name="top_btn_min_width">90dp</dimen>
</resources>
