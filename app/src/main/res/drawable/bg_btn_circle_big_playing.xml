<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形播放按钮背景:播放中(蓝色渐变) - 含按下反馈 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/playing_soft"
                android:endColor="@color/playing_mid" />
            <stroke android:width="1dp" android:color="@color/playing_pale" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/playing_bright"
                android:endColor="@color/playing_deep" />
            <stroke android:width="1dp" android:color="@color/playing_soft" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
</selector>
