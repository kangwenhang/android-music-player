<?xml version="1.0" encoding="utf-8"?>
<!-- 进度条样式:圆角轨道+蓝色进度+淡蓝缓冲段
     安卓4.x: clip+corners会在clip边界产生黑线,改用scale代替clip

     2026-10-03 v5.7.352 修复"填充条与圆点错位":
     运行时 thumb 是 18dp BitmapDrawable(MainActivity onCreate 里 setThumb 替换,
     XML 的 seekbar_thumb.xml 并未生效),其行程两端 inset 不对称,固定 XML
     inset 无法精确对齐 —— 现由 MainActivity.calibrateSeekbarFillInsets()
     在布局完成后实测标定(LayerDrawable.setLayerInset)。
     这里的 9dp(= 18dp/2)只是标定生效前的首帧兜底值;
     若调整运行时 thumb 尺寸(18dp),此处需同步。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景轨道(保持全宽,作为完整滑轨) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#2A2A34" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- 缓冲(次要进度)= 缓存进度:同色系 40% 透明度淡蓝,与亮蓝主进度"淡一档"区分 -->
    <item android:id="@android:id/secondaryProgress"
          android:left="9dp" android:right="9dp">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <solid android:color="#664FC3F7" />
                <corners android:radius="4dp" />
            </shape>
        </scale>
    </item>
    <!-- 主进度 -->
    <item android:id="@android:id/progress"
          android:left="9dp" android:right="9dp">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#4FC3F7"
                    android:endColor="#29B6F6" />
                <corners android:radius="4dp" />
            </shape>
        </scale>
    </item>
</layer-list>
