<?xml version="1.0" encoding="utf-8"?>
<!-- 进度条样式:圆角轨道+蓝色进度+淡蓝缓冲段
     安卓4.x: clip+corners会在clip边界产生黑线,改用scale代替clip

     2026-10-03 v5.7.351 修复"填充条与圆点错位":
     thumb(seekbar_thumb.xml 外层 22dp)的行程是 [thumbW/2, W-thumbW/2](两侧各缩进
     半个手柄宽),而 progress 层默认按 0..W 全宽缩放 —— 两者在 50% 处交叉,
     开始时填充终点在圆点左侧、结尾时跑到圆点右侧(用户实测确认)。
     修复:progress 与 secondaryProgress 层各加左右 11dp(= 22dp/2)inset,
     使填充映射区间与 thumb 行程完全重合,填充终点 ≡ 圆点中心(全程恒成立)。
     注意:若调整 seekbar_thumb.xml 的外层尺寸(22dp),这里的 11dp 必须同步改。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景轨道(保持全宽,作为完整滑轨) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#2A2A34" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <!-- 缓冲(次要进度)= 缓存进度:同色系 40% 透明度淡蓝,与亮蓝主进度"淡一档"区分 -->
    <item android:id="@android:id/secondaryProgress"
          android:left="11dp" android:right="11dp">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <solid android:color="#664FC3F7" />
                <corners android:radius="4dp" />
            </shape>
        </scale>
    </item>
    <!-- 主进度 -->
    <item android:id="@android:id/progress"
          android:left="11dp" android:right="11dp">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:startColor="#4FC3F7"
                    android:endColor="#29B6F6" />
                <corners android:radius="4dp" />
            </shape>
        </scale>
    </item>
</layer-list>
