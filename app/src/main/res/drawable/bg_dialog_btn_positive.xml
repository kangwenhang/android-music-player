<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗确认按钮背景(深蓝调,与整体深色风格统一) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_btn_press_a" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/pos_btn_press_b" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pos_btn_a" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/pos_btn_b" />
        </shape>
    </item>
</selector>
