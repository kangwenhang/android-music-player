<?xml version="1.0" encoding="utf-8"?>
<!-- 均衡器预设按钮背景(未选中状态) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4A4A52" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#5A5A62" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E2E34" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#3A3A42" />
        </shape>
    </item>
</selector>
