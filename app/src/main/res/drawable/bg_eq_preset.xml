<?xml version="1.0" encoding="utf-8"?>
<!-- 均衡器预设按钮背景(未选中:深色药丸形) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/seek_center_line"
                android:endColor="@color/preset_border" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/btn_border_press" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/dialog_btn_grad_start"
                android:endColor="@color/preset_grad_a" />
            <corners android:radius="26dp" />
            <stroke android:width="1dp" android:color="@color/dialog_btn_grad_end" />
        </shape>
    </item>
</selector>
