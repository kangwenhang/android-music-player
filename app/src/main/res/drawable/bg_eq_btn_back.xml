<?xml version="1.0" encoding="utf-8"?>
<!-- 均衡器按钮背景(普通:深色渐变圆角) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/btn_grad_press_start"
                android:endColor="@color/btn_grad_press_end" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/dialog_btn_grad_end"
                android:endColor="@color/dialog_btn_grad_start" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/btn_grad_press_end" />
        </shape>
    </item>
</selector>
