<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形按钮背景(小) - 渐变填充+边框,含按下反馈 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/btn_border_press"
                android:endColor="@color/circle_border" />
            <stroke android:width="1dp" android:color="@color/circle_border_press" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/circle_grad_a"
                android:endColor="@color/circle_grad_b" />
            <stroke android:width="1dp" android:color="@color/seek_center_line" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
</selector>
