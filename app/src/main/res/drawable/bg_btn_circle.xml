<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形按钮背景(小) - 渐变填充+边框,含按下反馈 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#5A5A66"
                android:endColor="#4A4A54" />
            <stroke android:width="1dp" android:color="#6A6A76" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#42424C"
                android:endColor="#363640" />
            <stroke android:width="1dp" android:color="#4A4A56" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
</selector>
