<?xml version="1.0" encoding="utf-8"?>
<!-- 普通按钮背景(渐变+边框,兼容 API 14) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/btn_grad_press_start"
                android:endColor="@color/btn_grad_press_end" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/btn_border_press" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/btn_grad_start"
                android:endColor="@color/btn_grad_end" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="@color/btn_border" />
        </shape>
    </item>
</selector>
