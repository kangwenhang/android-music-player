<?xml version="1.0" encoding="utf-8"?>
<!-- 普通按钮背景(渐变+边框,兼容 API 14) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#55555F"
                android:endColor="#45454F" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#5A5A66" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2A2A34"
                android:endColor="#22222C" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#333340" />
        </shape>
    </item>
</selector>
