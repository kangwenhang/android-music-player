<?xml version="1.0" encoding="utf-8"?>
<!-- 均衡器强调按钮(蓝色渐变,用于保存/绑定) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_light"
                android:endColor="@color/accent_deeper" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_bright"
                android:endColor="@color/accent_deep" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
