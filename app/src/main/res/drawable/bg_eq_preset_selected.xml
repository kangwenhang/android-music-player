<?xml version="1.0" encoding="utf-8"?>
<!-- 均衡器预设按钮背景(选中:蓝色渐变高亮) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_light"
                android:endColor="@color/accent_deep" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_bright"
                android:endColor="@color/accent_deep" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
