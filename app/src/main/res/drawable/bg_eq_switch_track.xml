<?xml version="1.0" encoding="utf-8"?>
<!-- 均衡器开关 Track 背景(关闭深灰,开启蓝色渐变) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/accent_bright"
                android:endColor="@color/accent_deep" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/toggle_track_off" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
