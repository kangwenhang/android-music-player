<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形播放按钮背景:暂停中(红色渐变) - 含按下反馈 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/paused_bright"
                android:endColor="@color/paused_deep" />
            <stroke android:width="1dp" android:color="@color/paused_pale" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="@color/btn_paused_bg"
                android:endColor="@color/paused_deeper" />
            <stroke android:width="1dp" android:color="@color/paused_soft" />
            <size android:width="80dp" android:height="80dp" />
        </shape>
    </item>
</selector>
