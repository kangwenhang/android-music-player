<?xml version="1.0" encoding="utf-8"?>
<!-- 缓存进度条样式(播放进度条下方的辅助条):
     主进度条是亮蓝渐变(#4FC3F7→#29B6F6),这条用同色系低透明度(#664FC3F7,40%)
     做视觉上的"淡一档"区分;细轨道(3dp 高)无 thumb,只读展示不响应拖动。
     安卓4.x:与 seekbar_progress 同样用 scale 代替 clip,避免 clip 边界黑线 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 背景轨道(比主条轨道 #2A2A34 更暗一点,进一步弱化存在感) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="#22222A" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <!-- 缓存进度(淡蓝) -->
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <solid android:color="#664FC3F7" />
                <corners android:radius="2dp" />
            </shape>
        </scale>
    </item>
</layer-list>
