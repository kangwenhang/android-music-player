<?xml version="1.0" encoding="utf-8"?>
<!-- 设置弹窗头部背景(深色渐变,匹配标题栏风格) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主背景:与标题栏一致 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/title_grad_start"
                android:endColor="@color/title_grad_end"
                android:angle="270" />
        </shape>
    </item>
    <!-- 底部1px蓝灰高光线 -->
    <item android:top="-1dp" android:bottom="-1dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="@color/title_line" />
        </shape>
    </item>
</layer-list>
