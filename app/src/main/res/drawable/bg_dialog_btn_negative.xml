<?xml version="1.0" encoding="utf-8"?>
<!-- 弹窗取消按钮背景(深色渐变) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#55555F"
                android:endColor="#45454F" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#3A3A44"
                android:endColor="#2E2E38" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#45454F" />
        </shape>
    </item>
</selector>
