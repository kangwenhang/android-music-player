<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 读取本地音乐(安卓 4.0 仅需声明,无需运行时申请) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <!-- 后台播放保持 CPU 唤醒 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 前台服务(通知栏常驻控制) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- 接收媒体按键(方向盘控制) -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 网络访问(Navidrome) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 震动反馈 -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CaptivaMusic">

        <!-- 主界面:横屏锁定,适配 1024x600 车机 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 均衡器界面 -->
        <activity
            android:name=".EqualizerActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Navidrome 服务器设置界面 -->
        <activity
            android:name=".ServerSettingsActivity"
            android:screenOrientation="landscape"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- 音乐后台服务:处理播放、通知栏、媒体按键 -->
        <service
            android:name=".MusicService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <action android:name="com.captiva.musicplayer.PLAY" />
                <action android:name="com.captiva.musicplayer.PAUSE" />
                <action android:name="com.captiva.musicplayer.NEXT" />
                <action android:name="com.captiva.musicplayer.PREV" />
                <action android:name="com.captiva.musicplayer.STOP" />
            </intent-filter>
        </service>

        <!-- 媒体按键接收器:接收系统分发的方向盘/耳机媒体键,转发给 Service -->
        <receiver
            android:name=".MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
